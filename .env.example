# Copy to .env.local and fill in. Never commit real keys.

# Dodo Payments: Developer -> API Keys (use a test mode key while developing)
DODO_PAYMENTS_API_KEY=
# Dodo Payments: Developer -> Webhooks -> your endpoint -> signing secret (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode. Anything else means test mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# The one-time product ($14.99 USD, with fixed local prices per country) with license keys turned on (pdt_...)
DODO_PRODUCT_ID=

# MongoDB connection string. The database name goes in the path, e.g. ...mongodb.net/my_mac_storage
MONGODB_URI=

# Bearer token for /api/admin/*. Generate one with: openssl rand -hex 32. Empty disables the admin API.
ADMIN_API_TOKEN=

# Optional. Time zone for dates in the admin panel, e.g. Asia/Kolkata. Defaults to UTC.
ADMIN_TIME_ZONE=

# Key the Mac app sends as X-App-Key to /api/app/v1/*. It ships inside the app, so it isn't a real secret.
# Generate one with: openssl rand -hex 24. Empty disables the app API (the appcast stays public).
APP_API_KEY=
