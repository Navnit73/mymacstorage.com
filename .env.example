# Copy to .env.local and fill in. Never commit real keys.

# Dodo Payments: Developer -> API Keys (use a test mode key while developing)
DODO_PAYMENTS_API_KEY=
# Dodo Payments: Developer -> Webhooks -> your endpoint -> signing secret (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode. Anything else means test mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# The $19.99 one-time product with license keys turned on (pdt_...)
DODO_PRODUCT_ID=

# Resend: API Keys (re_...)
RESEND_API_KEY=
# Sender on a domain verified in Resend
EMAIL_FROM="MyMacStorage <orders@mymacstorage.com>"

# Direct links to the installers
MAC_DOWNLOAD_URL=
# Optional. Leave empty to leave the Windows link out of the email.
WINDOWS_DOWNLOAD_URL=

# MongoDB connection string. The database name goes in the path, e.g. ...mongodb.net/my_mac_storage
MONGODB_URI=

# Bearer token for /api/admin/*. Generate one with: openssl rand -hex 32. Empty disables the admin API.
ADMIN_API_TOKEN=
